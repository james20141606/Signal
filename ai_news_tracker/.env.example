# Claude API Key (for AI summarization)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
